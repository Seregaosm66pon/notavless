# Telegram Userbot settings (optional, for parsing Telegram channels)
TG_API_ID=12345678
TG_API_HASH=your_api_hash
TG_SESSION_NAME=vpn_userbot
TG_SESSION_STRING=
VPN_SOURCE_CHANNELS=
VPN_CHANNEL_MESSAGE_LIMIT=50

# Telegram Bot Notifications (optional)
TG_NOTIFY_TOKEN=
TG_NOTIFY_CHANNEL=

# Sources file (defaults to sources.txt in repo root)
SOURCES_FILE=sources.txt

# Additional raw URLs separated by commas
GITHUB_VLESS_RAW_URLS=https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/main/Vless-Reality-White-Lists-Rus-Mobile.txt,https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/main/WHITE-CIDR-RU-checked.txt,https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/main/WHITE-CIDR-RU-all.txt,https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/main/BLACK_VLESS_RUS_mobile.txt,https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/main/BLACK_VLESS_RUS.txt,https://raw.githubusercontent.com/aviamastersgh/vpn-free-russia/main/ru_configs.txt,https://raw.githubusercontent.com/aviamastersgh/vpn-free-russia/main/verified_configs.txt,https://raw.githubusercontent.com/zieng2/wl/main/vless_lite.txt,https://raw.githubusercontent.com/prominbro/sub/refs/heads/main/212.txt

# Subscription output filenames
VPN_SUBSCRIPTION_OUTPUT=vlessall.txt
VPN_SUBSCRIPTION_OUTPUT_LEGACY=vless_subscription.txt
VPN_SUBSCRIPTION_OUTPUT_LTE=vless_lte.txt
VPN_SUBSCRIPTION_OUTPUT_WIFI=vless_wifi.txt

# Generate Base64 subscription files for apps requiring Base64 format (true/false)
GENERATE_BASE64=true

# Health check settings
CHECK_CONCURRENCY=64
CHECK_TIMEOUT=2.5

# Git commit message
VPN_GIT_COMMIT_MESSAGE=Update VLESS subscription
URL_TEST_TARGET=http://www.gstatic.com/generate_204
